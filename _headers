# Cloudflare Pages: cabeceras por tipo de archivo.
#
# Los HTML/CSS/JS no llevan hash en el nombre, así que se revalidan siempre:
# un deploy se ve al instante y no quedan visitantes con la versión vieja
# cacheada por horas.

/imagenes/*
  Cache-Control: public, max-age=3600

/icon/*
  Cache-Control: public, max-age=3600

/*
  Cache-Control: public, max-age=0, must-revalidate
